# The admin app's own Caddy, inside its container: serves the static build on :80 (plain HTTP on
# the internal network). TLS and the public hostname are handled by the shared Caddy in front.
:80 {
	root * /srv
	encode gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'self'; connect-src 'self' {$BACKEND_ORIGIN}; img-src 'self' data: https://*.openfreemap.org; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	# config.json is written at container start from the environment, and index.html (served for
	# every app route) must not be cached so a deploy picks up the new hashed assets.
	@nocache not path /assets/*
	header @nocache Cache-Control no-store
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Extraction jobs service (same origin, so no CORS). Must be a handle block placed before the
	# static handler: a top-level try_files would otherwise rewrite /jobs/* to /index.html first.
	handle /jobs/* {
		reverse_proxy {$JOBS_UPSTREAM:jobs:8000}
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
