# The admin app's own Caddy, inside its container: serves the static build on :80 (plain HTTP on
# the internal network). TLS and the public hostname are handled by the shared Caddy in front.
:80 {
	root * /srv
	encode gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'self'; connect-src 'self' {$BACKEND_ORIGIN}; img-src 'self' data: https://*.openfreemap.org; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	# config.json is written at container start from the environment, and index.html (served for
	# every app route) must not be cached so a deploy picks up the new hashed assets.
	@nocache not path /assets/* /claim/assets/*
	header @nocache Cache-Control no-store
	@assets path /assets/* /claim/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The participant claim page (claim/): its own SPA under /claim. MapLibre fetches the
	# OpenFreeMap style, tiles, fonts and sprites, and runs its worker from a blob: URL.
	@claim path /claim /claim/*
	handle @claim {
		header Content-Security-Policy "default-src 'self'; connect-src 'self' {$BACKEND_ORIGIN} https://tiles.openfreemap.org; img-src 'self' data: blob: https://tiles.openfreemap.org; worker-src blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		try_files {path} /claim/index.html
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
